//Butterfly

import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner obj=new Scanner(System.in);
	    int n=obj.nextInt();
	    int row,col;
	    for(row=0;row<n-1;row++,System.out.println()){
	        for(col=0;col<=row;col++)
		    System.out.print("*");
	        for(col=0;col<=n-row-2;col++)
		    System.out.print(" ");
		    for(col=0;col<=n-row-2;col++)
		    System.out.print(" ");
		    for(col=0;col<=row;col++)
		    System.out.print("*");
	    }
		 for(row=0;row<n;row++,System.out.println()){
		    for(col=0;col<=n-row-1;col++)
		    System.out.print("*");
	        for(col=0;col<=row-1;col++)
		    System.out.print(" ");
		    for(col=0;col<=row-1;col++)
		    System.out.print(" ");
		    for(col=0;col<=n-row-1;col++)
		    System.out.print("*");
	    }
	}
}

