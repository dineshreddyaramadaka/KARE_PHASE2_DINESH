//switch

import java.util.*;
class Main
{
	public static void main(String[] args) {
	    Scanner obj=new Scanner(System.in);
	    int n=obj.nextInt();
	    switch(n)
	    {
	        case 1:
	            System.out.print("CSE");
	            break;
	        case 2:
	            System.out.print("ECE");
	            break;
	        case 3:
	            System.out.print("EEE");
	            break;
	            default:
	            System.out.print("Invalid input");
	    }
	}
}

//calculator

import java.util.*;
class Main
{
	public static void main(String[] args) {
	    Scanner obj=new Scanner(System.in);
	    int a = obj.nextInt();
	    int b = obj.nextInt();
	    char c = obj.next().charAt(0);
	    switch(c)
	    {
	        case '+':
	            System.out.print(a+b);
	            break;
	        case '-':
	            System.out.print(a-b);
	            break;
	        case '*':
	            System.out.print(a*b);
	        case '/':
	            System.out.print(a/b);
	            break;
	        case '%':
	            System.out.print(a%b);
	            break;
	            default:
	            System.out.print("Invalid input");
	    }
	}
}

//write a java program to print n natural number

import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner obj = new Scanner(System.in);
	    int n=obj.nextInt();
	    int i;
	    for(i=1;i<=n;i++)
		System.out.println(i+" ");
	}
}

