    public static void main (String[] args) {
        Scanner obj=new Scanner(System.in);
        int n=obj.nextInt();
        int arr[][]=new int[n][n];
        int i,j;
        System.out.print("Enter array elements: ");
        for(i=0;i<n;i++)
        {
            for(j=0;j<n;j++)
            {
                arr[i][j]=obj.nextInt();
            }
        }
        System.out.println("First Diagonal Element: ");
        for(i=0;i<n;i++)
        System.out.print(arr[i][i]+" ");
