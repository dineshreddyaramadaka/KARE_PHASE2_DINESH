//reverse the given String

import java.util.*;
class Main
    {
        public static void main (String[] args) {
            Scanner obj=new Scanner(System.in);
            String str=obj.nextLine();
            char ch[]=str.toCharArray();
            int s=0;
            int e=ch.length-1;
            while(s<e)
            {
                char temp = ch[s];
                ch[s] = ch[e];
                ch[e] = temp;
                s++;
                e--;
            }
            System.out.println(new String(ch));
    }
}

//check the string palindrone are not

import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner obj = new Scanner(System.in);
        System.out.print("Enter string: ");
        String s=obj.nextLine();
        String r="";
        int l=s.length();
        
        for (int i=l-1;i>=0;i--) {
            r=r+s.charAt(i);
        }
        if (s.equals(r)) {
            System.out.println("Palindrome");
        } else {
            System.out.println("Not Palindrome");
        }
    }
}

//Unique Element Count

import java.util.*;
class Main
    {
        public static void main (String[] args) {
            Scanner obj=new Scanner(System.in);
            String s=obj.nextLine();
            int arr[]=new int[256];
            int c=0;
            for(char ch:s.toCharArray())
            {
                arr[ch]++;
            }
            for(int i=0;i<256;i++)
            {
                if(arr[i]==1)
                c++;
            }
            System.out.print("Unique Element Count: "+c);
    }
}
