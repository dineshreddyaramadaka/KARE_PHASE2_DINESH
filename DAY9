//write a java program to create & display the 2D array elements

import java.util.*;
class Main {
    public static void main (String[] args) {
        Scanner obj=new Scanner(System.in);
        System.out.print("Enter no of rows: ");
        int r=obj.nextInt();
        System.out.print("Enter no of colms: ");
        int c=obj.nextInt();
        int arr[][]=new int[r][c];
        int i,j;
        System.out.print("Enter array elements:");
        for(i=0;i<r;i++)
        {
            for(j=0;j<c;j++)
            {
                arr[i][j]=obj.nextInt();
            }
        }
        for(i=0;i<r;i++,System.out.println())
        {
            for(j=0;j<c;j++)
            {
                System.out.print(arr[i][j]+" ");
            }
        }
    }
}

//write a java program to print primary & secondary diagonal elements

import java.util.*;
