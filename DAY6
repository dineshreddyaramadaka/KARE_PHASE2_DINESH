//  Strong number
//1 get the input from user n=145
//2 find the factorial value of each digit(1!, 4!, 5!)
//3 sum all the factorial values sum=1+24+120=145
//4 if sum==n print Strong number

import java.util.*;
class Main
{
    public static void main (String[] args) {
        Scanner obj=new Scanner(System.in);
        int n=obj.nextInt();
        int temp=n;
        int d,fact,sum=0;
        while(n!=0)
        {
            fact=1;
            d=n%10;
            for(int i=1;i<=d;i++)
            fact=fact*i;
            sum=sum+fact;
            n=n/10;
        }
        if(temp==sum)
        System.out.print("STRONG NUMBER");
        else
        System.out.print("NOT A STRONG NUMBER");
    }
}

//  Armtrong number
//1 get the input from user n=153
//2 count the no.of digits count=3
//3 Segregate each digit & make the power value as per count value 1^3 = 1 5^3 = 125 3^3 = 27
//4 find the sum of all power values sum=1+125+27=153
//5 if sum==given number print Armstrong number
// Math.pow(basevalue,powervalue)

import java.util.*;
class Main
{
    public static void main (String[] args) {
        Scanner obj=new Scanner(System.in);
        int n=obj.nextInt();
        int temp=n,c=0,d,sum=0;
        while(n!=0)
        {
            n=n/10;
            c++;
        }
        n=temp;
        while(n!=0)
        {
            d=n%10;
            sum=sum+(int)Math.pow(d,c);
            n=n/10;
        }
        if(temp==sum)
        System.out.print("ARMSTRONG NUMBER");
        else
        System.out.print("NOT A STRONG NUMBER");
    }
}
