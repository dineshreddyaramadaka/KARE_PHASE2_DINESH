//unary operator

public class Main
{
	public static void main(String[] args) {
	    int a=29;
	    int b=a++;
	    int c=--b;
	    int d=c++;
	    int e=++d;
	    System.out.println(a+" "+b+" "+c+" "+d+" "+e);
	}
}

//print f++ next abcdef

public class Main
{
	public static void main(String[] args) {
	    int a=99;
	    int b=a++;
	    int c=b--;
	    int d=--c;
	    int e=d++;
	    int f=e--;
	    System.out.println(f++);
	    System.out.println(a+" "+b+" "+c+" "+d+" "+e+" "+f);
	}
}

