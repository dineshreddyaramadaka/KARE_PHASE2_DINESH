//Smallest of 3 numbers

import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner obj=new Scanner(System.in);
	    int a,b,c;
	    a=obj.nextInt();
	    b=obj.nextInt();
	    c=obj.nextInt();
	    if(a<=b && a<=c)
	    {
		    System.out.println(a);
	    }
	    else if(b<=a && b<=c)
	    {
	        System.out.println(b);
	    }
		else
		{
	    	System.out.println(c);
		}
	}
}

