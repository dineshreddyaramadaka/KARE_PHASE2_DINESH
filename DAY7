//write a java program to find the sum of array elements

import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner obj=new Scanner(System.in);
        int n=obj.nextInt();
        int arr[]=new int[n];
        int i,sum=0;
        for(i=0;i<n;i++){
            arr[i]=obj.nextInt();
            sum=sum+arr[0];
        }
        System.out.print("Sum of array Elements "+sum);
    }
}

//write a java program to find the odd even element count in the given array
//i/p               o/p
//5
//10 2 34 5 23      odd element count: 2
//                  even element count: 3

import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner obj=new Scanner(System.in);
        int n=obj.nextInt();
        int arr[]=new int[n];
        int i,oc=0,ec=0;
        for(i=0;i<n;i++) {
        arr[i]=obj.nextInt();
        if(arr[i]%2==0)
        ec++;
        else
        oc++;
    }
        System.out.println("odd element count: "+oc);
        System.out.println("even element count: "+ec);
    }
}

