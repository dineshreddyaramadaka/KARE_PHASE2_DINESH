//search an element in the array

import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner obj=new Scanner(System.in);
        int n=obj.nextInt();
        int arr[]=new int[n];
        int i,index,value,flag=0;
        for(i=0;i<n;i++) {
            arr[i]=obj.nextInt();
        }
        value=obj.nextInt();
        for(i=0;i<n;i++){
        if(arr[i]==value){
            flag=1;
        System.out.print("Element Found");
        break;
        }
        }
        if(flag==0)
        System.out.print("Not Found");
    }
}

//reverse elements in the array

import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner obj=new Scanner(System.in);
        int n=obj.nextInt();
        int arr[]=new int[n];
        int i;
        for(i=0;i<n;i++){
        arr[i]=obj.nextInt();
        }
        for(i=n-1;i>=0;i--) {
        System.out.print(arr[i]+" ");
        }
    }
}
