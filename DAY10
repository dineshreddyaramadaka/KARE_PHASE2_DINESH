            else if(arr[mid]>t)
            high=mid-1;
        }
        if(flag==0)
        System.out.print("Element is not Found");
    }
}

//Bubble Sort

import java.util.*;
class Main
{
    public static void main (String[] args) {
        Scanner obj=new Scanner(System.in);
        int n=obj.nextInt();
        int arr[]=new int[n];
        int i,j,temp;
        for(i=0;i<n;i++)
        arr[i]=obj.nextInt();
        for(i=0;i<n;i++)
        {
            for(j=0;j<n-i-1;j++)
            {
                if (arr[j]>arr[j+1])
                {
                    temp=arr[j];
                    arr[j]=arr[j+1];
                    arr[j+1]=temp;
                }
            }
        }
        for(i=0;i<n;i++)
            System.out.print(arr[i]+" ");
    }
}

//Selection Sort

import java.util.*;
class Main
{
    public static void main (String[] args) {
        Scanner obj=new Scanner(System.in);
        int n=obj.nextInt();
        int arr[]=new int[n];
        int i,j,minind;
        for(i=0;i<n;i++)
        arr[i]=obj.nextInt();
        for(i=0;i<n-1;i++)
        {
            minind=i;
            for(j=i+1;j<n;j++)
            {
                if (arr[j]<arr[minind])
                minind=j;
            }
            int temp=arr[i];
            arr[i]=arr[minind];
            arr[minind]=temp;
        }
        for(i=0;i<n;i++)
            System.out.print(arr[i]+" ");
    }
}

//Insertion Sort

import java.util.*;
class Main
{
    public static void main (String[] args) {
        Scanner obj=new Scanner(System.in);
        int n=obj.nextInt();
        int arr[]=new int[n];
        for(int i=0;i<n;i++)
        {
            arr[i]=obj.nextInt();
        }
        for(int i=1;i<n;i++)
        {
            int key=arr[i];
            int j=i-1;
            while(j>=0 && arr[j]>key)
            {
                arr[j+1]=arr[j];
                j--;
            }
            arr[j+1]=key;
        }
        for(int i=0;i<n;i++)
            System.out.print(arr[i]+" ");
    }
}
