import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner obj=new Scanner(System.in);
	    int n=obj.nextInt();
	    int arr[]=new int[n-1];
	    int i,sum=0;
	    for(i=0;i<n-1;i++){
	        arr[i]=obj.nextInt();
	        sum=sum+arr[i];
	    }
	    int sumn=n*(n+1)/2;
		System.out.print("Missing Number: "+(sumn-sum));
	}
}
