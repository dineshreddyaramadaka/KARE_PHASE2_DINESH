//Single Number

import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner obj=new Scanner(System.in);
	    int n=obj.nextInt();
	    int arr[]=new int[n];
	    int i,m=0;
	    for(i=0;i<n;i++){
	        arr[i]=obj.nextInt();
	        m=m^arr[i];
	    }
		System.out.println("Single Number: "+m);
	}
}

